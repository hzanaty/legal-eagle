{
  "version": "v3.3",
  "base": "v3.2",
  "description": "Tagging + email rank gate live. Delta over v3.2 — adds email eligibility + topic_label assertions.",
  "assertions": [
    {"type": "column_exists", "table": "news_items", "column": "topic_label",    "description": "news_items.topic_label column exists"},
    {"type": "column_exists", "table": "news_items", "column": "email_eligible", "description": "news_items.email_eligible column exists"},
    {"type": "column_exists", "table": "news_items", "column": "email_sent",     "description": "news_items.email_sent column exists"},
    {"type": "column_exists", "table": "runs",       "column": "email_status",   "description": "runs.email_status column exists"},
    {"type": "table_exists",  "table": "news_aspects",                           "description": "news_aspects table exists"},

    {"type": "item_outcome", "title_contains": "maternity leave",
     "expect_table": "news_items",
     "fields": {"email_eligible": "1"}, "not_null": ["topic_label"],
     "description": "A1 maternity leave — rank 4, tagged → email_eligible=1"},

    {"type": "item_outcome", "title_contains": "termination notice period",
     "expect_table": "news_items",
     "fields": {"email_eligible": "1"}, "not_null": ["topic_label"],
     "description": "A3 termination notice — rank 4, tagged → email_eligible=1"},

    {"type": "item_outcome", "title_contains": "pension fund reform",
     "expect_table": "news_items",
     "fields": {"email_eligible": "1"}, "not_null": ["topic_label"],
     "description": "A4 pension fund reform — rank 3, tagged → email_eligible=1"},

    {"type": "item_outcome", "title_contains": "mandatory health insurance for part-time",
     "expect_table": "news_items",
     "fields": {"email_eligible": "1"}, "not_null": ["topic_label"],
     "requires_ai": true,
     "description": "C4 health insurance — rank 3 (requires embedding cache) → email_eligible=1"},

    {"type": "item_outcome", "title_contains": "updated social insurance contribution schedule",
     "expect_table": "news_items",
     "fields": {"email_eligible": "0"},
     "description": "C1 duplicate (rank 0) → email_eligible=0"},

    {"type": "item_outcome", "title_contains": "circular: updated contribution table published",
     "expect_table": "news_items",
     "fields": {"email_eligible": "0"},
     "description": "R1 duplicate (rank 0) → email_eligible=0"},

    {"type": "item_outcome", "title_contains": "payroll compliance deadline extended",
     "expect_table": "news_items",
     "fields": {"email_eligible": "0"},
     "description": "R2 duplicate (rank 0) → email_eligible=0"}
  ]
}
