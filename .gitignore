# Python artifacts
__pycache__/
*.py[cod]
*.egg-info/
.env

# macOS
.DS_Store

# VS Code
.vscode/

# Logs
*.log

# Playwright/browser caches (local snapshots)
snapshots/
.playwright-mcp/

# Superpowers local files (Claude tooling, not part of project)
.superpowers/
docs/superpowers/
# Test run artifacts (ignore local test outputs written by scripts)
scripts/test_runs/
scripts/archive/
Restore/

# Generated outputs (keep latest_all_news.json tracked by workflow; ignore dated dumps)
outputs/all_news_*.json
# SQLite DB files (do not commit local config databases)
configurations/*.db

# Environment files (ignore all .env variants anywhere)
.env.*
**/.env
**/.env.*
# Sensitive credentials file (use environment variables instead)
configurations/credentials.json
archive/

# MCP server (local development only, not part of this project)
mcp/

# BTP seed data (contains email addresses — not for git, but deployed via cf push)
scripts/btp_seed_data.json
