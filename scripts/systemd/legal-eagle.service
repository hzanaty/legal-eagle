[Unit]
Description=Legal Eagle scheduled runner (DB-logged)
# For user-level unit, place in ~/.config/systemd/user/legal-eagle.service
# For system-level unit, place in /etc/systemd/system/legal-eagle.service

[Service]
Type=oneshot
# Ensure the project root exists and is used as working directory
WorkingDirectory=/Users/i077750/Documents/GitHub/legal-eagle
# Optional environment variables
# Environment=DISABLE_TWEETS=1
Environment=PYTHONPATH=/Users/i077750/Documents/GitHub/legal-eagle
# Entrypoint wrapper (handles cd/PYTHONPATH and venv activation if needed)
ExecStart=/bin/zsh /Users/i077750/Documents/GitHub/legal-eagle/scripts/scheduler_entry.sh
# If you want to ignore schedule_day filter, append --ignore-schedule:
# ExecStart=/bin/zsh /Users/i077750/Documents/GitHub/legal-eagle/scripts/scheduler_entry.sh --ignore-schedule

# Logging (journald). To also log to files, keep wrapper logging or pipe via sh -c '... >> file 2>&1'
# ProtectSystem=full  # Uncomment if running as system service with tightened permissions

[Install]
WantedBy=multi-user.target
