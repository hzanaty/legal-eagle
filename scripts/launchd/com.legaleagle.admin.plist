<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
Legal Eagle Admin Server (user LaunchAgent)
Runs the Flask admin web interface on http://127.0.0.1:8080

Installation (IMPORTANT: copy as real file, do NOT symlink):
  cp scripts/launchd/com.legaleagle.admin.plist ~/Library/LaunchAgents/
  launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.legaleagle.admin.plist

Unload:
  launchctl bootout gui/$(id -u)/com.legaleagle.admin

Check status:
  launchctl print gui/$(id -u)/com.legaleagle.admin

View logs:
  tail -f outputs/admin-stdout.log
  tail -f outputs/admin-stderr.log

Troubleshooting (macOS Sequoia+):
  If exit code 78 / spawn scheduled loop:
  - Delete old log files: rm outputs/admin-stdout.log outputs/admin-stderr.log
  - Bootout, then bootstrap again
-->
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.legaleagle.admin</string>

    <key>WorkingDirectory</key>
    <string>/Users/i077750/Documents/GitHub/legal-eagle</string>

    <!-- Use Python launcher wrapper — truncates logs on each start to prevent exit code 78 on macOS Sequoia+ -->
    <key>ProgramArguments</key>
    <array>
      <string>/Library/Frameworks/Python.framework/Versions/3.13/bin/python3</string>
      <string>/Users/i077750/Documents/GitHub/legal-eagle/scripts/admin_launcher.py</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
      <key>PYTHONPATH</key>
      <string>/Users/i077750/Documents/GitHub/legal-eagle</string>
      <key>PYTHONUNBUFFERED</key>
      <string>1</string>
      <key>FLASK_ENV</key>
      <string>production</string>
      <key>HOME</key>
      <string>/Users/i077750</string>
    </dict>

    <!-- Keep the server running always; restart automatically after crash -->
    <key>KeepAlive</key>
    <true/>

    <!-- Start on login -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Logs -->
    <key>StandardOutPath</key>
    <string>/Users/i077750/Documents/GitHub/legal-eagle/outputs/admin-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/i077750/Documents/GitHub/legal-eagle/outputs/admin-stderr.log</string>

    <!-- Throttle rapid restarts to 10 seconds -->
    <key>ThrottleInterval</key>
    <integer>10</integer>
  </dict>
</plist>
