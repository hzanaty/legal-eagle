<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
Legal Eagle launchd scheduler (user LaunchAgent)
Copy to: ~/Library/LaunchAgents/com.legaleagle.scheduler.plist
Load:     launchctl load -w ~/Library/LaunchAgents/com.legaleagle.scheduler.plist
Unload:   launchctl unload ~/Library/LaunchAgents/com.legaleagle.scheduler.plist

Notes:
- StartCalendarInterval: runs once daily at the specified hour/minute in local timezone.
- The Python runner applies Dubai day-of-week gating internally (UTC+4). It will skip profiles whose schedule_day doesn't match today's Dubai weekday.
- Update WorkingDirectory and ProgramArguments paths if this project is in a different location.
- To run all active profiles regardless of schedule_day, add the argument --ignore-schedule.
-->
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.legaleagle.scheduler</string>

    <key>WorkingDirectory</key>
    <string>/Users/i077750/Documents/GitHub/legal-eagle</string>

    <key>ProgramArguments</key>
    <array>
      <string>/bin/zsh</string>
      <string>/Users/i077750/Documents/GitHub/legal-eagle/scripts/scheduler_entry.sh</string>
      <!-- Uncomment to ignore schedule_day and run all active profiles -->
      <!-- <string>--ignore-schedule</string> -->
    </array>

    <!-- Run daily at 12:00 local time -->
    <key>StartCalendarInterval</key>
    <dict>
      <key>Hour</key>
      <integer>12</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>

    <!-- KeepAlive false = run on schedule only -->
    <key>KeepAlive</key>
    <false/>

    <!-- Start on load (optional). If true, runs once on load in addition to schedule -->
    <key>RunAtLoad</key>
    <false/>

    <!-- Environment variables -->
    <key>EnvironmentVariables</key>
    <dict>
      <!-- Set to 1 to disable tweets during scheduled runs -->
      <!-- <key>DISABLE_TWEETS</key><string>1</string> -->
      <key>PYTHONPATH</key>
      <string>/Users/i077750/Documents/GitHub/legal-eagle</string>
    </dict>

    <!-- Logs -->
    <key>StandardOutPath</key>
    <string>/Users/i077750/Documents/GitHub/legal-eagle/outputs/launchd-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/i077750/Documents/GitHub/legal-eagle/outputs/launchd-stderr.log</string>
  </dict>
</plist>
